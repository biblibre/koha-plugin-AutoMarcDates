[% INCLUDE 'doc-head-open.inc' %]
    <title>AutoMarcDates Configuration &rsaquo; Koha</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs">
    <a href="/cgi-bin/koha/mainpage.pl">Home</a>
    &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
    &rsaquo; AutoMarcDates
    &rsaquo; Configuration
</div>

<div class="main container-fluid">
<div class="row">
<div class="col-md-10 offset-md-2">
<main>

<h3>AutoMarcDates Configuration</h3>

<form action="/cgi-bin/koha/plugins/run.pl" method="post">
    [% INCLUDE 'csrf-token.inc' %]
    <input type="hidden" name="class" value="[% CLASS | html %]" />
    <input type="hidden" name="method" value="[% METHOD | html %]" />
    <input type="hidden" name="op" value="cud-save" />

    <fieldset class="rows">
        <legend>Enable plugin for:</legend>
        <ol>
            <li>
                <label for="enable_biblio" style="width:20em;float:none;">
                [% IF enable_biblio %]
                    <input type="checkbox" id="enable_biblio" name="enable_biblio" value="1" checked="checked" />
                [% ELSE %]
                    <input type="checkbox" id="enable_biblio" name="enable_biblio" value="1" />
                [% END %]
                    <span>Bibliographic records</span>
                </label>
            </li>
            <li>
                <label for="enable_authority" style="width:20em;float:none;">
                [% IF enable_authority %]
                    <input type="checkbox" id="enable_authority" name="enable_authority" value="1" checked="checked" />
                [% ELSE %]
                    <input type="checkbox" id="enable_authority" name="enable_authority" value="1" />
                [% END %]
                <span>Authority records</span>
            </label>
            </li>
        </ol>
    </fieldset>

    <fieldset class="rows">
        <ol>
            <li>
                <label for="biblio_created_field">Biblio MARC field for creation date</label>
                <input type="text" id="biblio_created_field" name="biblio_created_field" value="[% biblio_created_field | html %]" />
                <label for="biblio_created_override" style="width:20em;float:none;">
                    [% IF biblio_created_override %]
                        <input type="checkbox" id="biblio_created_override" name="biblio_created_override" value="1" checked="checked" />
                    [% ELSE %]
                        <input type="checkbox" id="biblio_created_override" name="biblio_created_override" value="1" />
                    [% END %]
                    Override if already exists
                </label>
                <div class="hint">Example: 099$c</div>
            </li>
            <li>
                <label for="biblio_updated_field">Biblio MARC field for modification date</label>
                <input type="text" id="biblio_updated_field" name="biblio_updated_field" value="[% biblio_updated_field | html %]" />
                <div class="hint">Example: 099$d</div>
            </li>
        </ol>
    </fieldset>

    <fieldset class="rows">
        <ol>
            <li>
                <label for="authority_created_field">Authority MARC field for creation date</label>
                <input type="text" id="authority_created_field" name="authority_created_field" value="[% authority_created_field | html %]" />
                <label for="authority_created_override" style="width:20em;float:none;">
                    [% IF authority_created_override %]
                        <input type="checkbox" id="authority_created_override" name="authority_created_override" value="1" checked="checked" />
                    [% ELSE %]
                        <input type="checkbox" id="authority_created_override" name="authority_created_override" value="1" />
                    [% END %]
                    Override if already exists
                </label>
                <div class="hint">Example: 099$e</div>
            </li>
            <li>
                <label for="authority_updated_field">Authority MARC field for modification date</label>
                <input type="text" id="authority_updated_field" name="authority_updated_field" value="[% authority_updated_field | html %]" />
                <div class="hint">Example: 099$f</div>
            </li>
        </ol>
    </fieldset>

    <fieldset class="action">
        <input type="submit" class="btn btn-primary" value="Save" />
    </fieldset>

</form>

</main>
</div> <!-- /.col-md-10.order-md-2 -->
</div> <!-- /.row -->
</div> <!-- /.main.container-fluid -->

[% INCLUDE 'intranet-bottom.inc' %]
